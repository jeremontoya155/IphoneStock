<!-- Carrito de compras (checkout por WhatsApp). Lógica en /js/store-cart.js -->
<button type="button" class="cart-fab" id="cart-fab" aria-label="Abrir carrito" hidden>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6L5 3H2"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/></svg>
    <span class="cart-fab__count" id="cart-fab-count">0</span>
</button>

<div class="cart-overlay" id="cart-overlay" hidden></div>
<aside class="cart-drawer" id="cart-drawer" role="dialog" aria-modal="true" aria-labelledby="cart-title" aria-hidden="true">
    <header class="cart-drawer__head">
        <h2 id="cart-title">Tu carrito</h2>
        <button type="button" class="cart-drawer__close" id="cart-close" aria-label="Cerrar carrito">&times;</button>
    </header>

    <div class="cart-drawer__body" id="cart-body"></div>

    <footer class="cart-drawer__foot" id="cart-foot" hidden>
        <div class="cart-totals" id="cart-totals"></div>
        <input type="text" id="cart-nombre" class="cart-input" placeholder="Tu nombre (opcional)" maxlength="60" autocomplete="name">
        <button type="button" class="btn-whatsapp" id="cart-checkout">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 21l2.1-5.2A8.5 8.5 0 1 1 21 11.5z"/><path d="M9 9.5c0 3 2.500 5.500 5.500 5.500l1.200-1.500-2-1-.8.800a4 4 0 0 1-1.700-1.700l.8-.8-1-2z"/></svg>
            Pedir por WhatsApp
        </button>
        <button type="button" class="btn-link" id="cart-clear">Vaciar carrito</button>
        <p class="cart-note">Te respondemos por WhatsApp para confirmar disponibilidad y coordinar el pago.</p>
    </footer>
</aside>

<div class="cart-toast" id="cart-toast" role="status" aria-live="polite"></div>

<% if (typeof isLogged !== 'undefined' && isLogged) { %>
<a class="admin-pill" href="/panel" title="Volver al panel de gestión">⚙️ Panel</a>
<% } %>

<script src="/js/store-cart.js?v=5" defer></script>

<% if (typeof campania !== 'undefined' && campania && campania.aviso) { %>
<%- include('campaniaAviso', { c: campania }) %>
<% } %>
