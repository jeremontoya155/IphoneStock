<%
  // ---- Datos de la tarjeta (oferta, moneda, cuotas) ----
  const tieneOferta = product.tiene_oferta_vigente;
  const precioOriginal = Number(product.price);
  const precioFinal = Number(product.precio_final || product.price);
  const porcentajeDescuento = tieneOferta && product.tipo_descuento === 'porcentaje' ? product.valor_descuento : null;
  const esOfertaGeneral = product.es_oferta_general || false;
  const nombreOfertaGeneral = product.nombre_oferta_general || '';

  const cotiz = typeof cotizacionDolar !== 'undefined' ? cotizacionDolar : 1200;
  const monedaProd = product.moneda || 'USD';
  const esUSD = monedaProd === 'USD';
  const simbolo = esUSD ? 'USD' : 'ARS $';
  const fmtPrecio = (n) => Number(n).toLocaleString('es-AR', { maximumFractionDigits: 2 });

  // Nombre: "IPHONE 13 / 128GB / ROJO" -> título + detalles
  const nameParts = String(product.name || '').split('/').map(p => p.trim()).filter(Boolean);
  const titulo = nameParts[0] || product.name;
  const detalles = nameParts.slice(1);

  // Cuotas
  let planesCard = [];
  try { planesCard = JSON.parse(product.cuotas_planes || '[]'); } catch (e) { planesCard = []; }
  if (planesCard.length === 0 && product.cuotas_max && product.cuotas_max > 0) {
    planesCard = [{ cuotas: product.cuotas_max, interes: product.interes_cuotas || 0 }];
  }
  let cuotaTexto = null, sinInteres = false, hastaCuotas = false;
  if (planesCard.length > 0) {
    const mejorPlan = planesCard[planesCard.length - 1];
    const base = tieneOferta ? precioFinal : precioOriginal;
    const basePesos = esUSD ? (base * cotiz) : base;
    const total = mejorPlan.interes > 0 ? (basePesos * (1 + mejorPlan.interes / 100)) : basePesos;
    cuotaTexto = { n: mejorPlan.cuotas, valor: Math.round(total / mejorPlan.cuotas).toLocaleString('es-AR') };
    sinInteres = !mejorPlan.interes || mejorPlan.interes === 0;
    hastaCuotas = planesCard.length > 1;
  }
%>
<article class="product-card fade-in-section"
     data-stock="<%= product.stock %>"
     data-estado="<%= product.estado || '' %>"
     data-storage="<%= product.almacenamiento || 0 %>"
     data-battery="<%= product.bateria || 0 %>"
     data-model="<%= product.name %>"
     data-price="<%= product.price %>"
     data-category="<%= product.categoria_id || '' %>">

  <% if (tieneOferta) { %>
  <div class="oferta-badge"><%= porcentajeDescuento ? '-' + porcentajeDescuento + '%' : 'OFERTA' %></div>
  <% } %>

  <a class="product-image-container" href="/product/<%= product.id %>" aria-label="Ver <%= product.name %>">
    <img src="<%= product.img %>" alt="<%= product.name %>" class="product-image" loading="lazy" decoding="async" width="400" height="400">
  </a>

  <div class="product-details">
    <div class="pc-meta">
      <% if (product.estado) { %><span class="pc-pill"><%= product.estado %></span><% } %>
      <% if (product.bateria) { %>
      <span class="battery-status" title="Salud de batería">
        <img src="/imgs/bateria.png" alt="" class="battery-icon" width="14" height="14">
        <span class="bateria"><span class="bateria-num"><%= product.bateria %></span>%</span>
      </span>
      <% } %>
    </div>

    <h3 class="product-name pc-title"><a href="/product/<%= product.id %>"><%= titulo %></a></h3>
    <% if (detalles.length) { %>
    <p class="pc-sub"><%= detalles.join(' · ') %></p>
    <% } %>

    <% if (tieneOferta) { %>
    <div class="precio-container precio-container--oferta">
      <div class="oferta-precios">
        <span class="precio-oferta"><%= simbolo %> <%= fmtPrecio(precioFinal) %></span>
        <span class="precio-original"><%= simbolo %> <%= fmtPrecio(precioOriginal) %></span>
      </div>
      <div class="oferta-meta">
        <span class="ahorro-text">Ahorrás <%= simbolo %> <%= fmtPrecio(precioOriginal - precioFinal) %></span>
        <% if (esOfertaGeneral && nombreOfertaGeneral) { %><span class="oferta-chip"><%= nombreOfertaGeneral %></span><% } %>
      </div>
    </div>
    <% } else { %>
    <p class="product-price precio"><%= simbolo %> <%= fmtPrecio(precioOriginal) %></p>
    <% } %>

    <% if (cuotaTexto) { %>
    <p class="cuotas-badge">
      <span class="cuotas-badge__text">
        <%= hastaCuotas ? 'Hasta ' : '' %><strong><%= cuotaTexto.n %> cuotas</strong> de <strong>ARS $<%= cuotaTexto.valor %></strong>
        <% if (sinInteres) { %><span class="cuotas-sin-interes">sin interés</span><% } %>
      </span>
    </p>
    <% } %>

    <div class="product-footer">
      <button type="button" class="btn-add-cart" data-add-to-cart data-id="<%= product.id %>" data-name="<%= product.name %>" <%= product.stock > 0 ? '' : 'disabled' %>>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6h15l-1.5 9h-12z"/><path d="M6 6L5 3H2"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/></svg>
        Agregar
      </button>
      <a class="btn-ver-mas-small" href="/product/<%= product.id %>">Ver</a>
    </div>
  </div>
</article>
