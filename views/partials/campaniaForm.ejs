<%
    const c = campaniaCfg;
    const o = campaniaOferta;
    // Las columnas son "hora local" sin zona: se muestran tal cual quedaron guardadas
    const p2 = n => String(n).padStart(2, '0');
    const local = d => { const x = new Date(d); return x.getFullYear() + '-' + p2(x.getMonth() + 1) + '-' + p2(x.getDate()) + 'T' + p2(x.getHours()) + ':' + p2(x.getMinutes()); };
    const hoy = new Date();
    const anio = hoy.getFullYear();
    // Black Friday: viernes siguiente al cuarto jueves de noviembre
    const viernes = a => { const primero = new Date(a, 10, 1).getDay(); return 1 + ((4 - primero + 7) % 7) + 22; };
    const dia = viernes(anio);
    const desde = o ? local(o.fecha_inicio) : anio + '-11-' + p2(dia) + 'T00:00';
    const hasta = o ? local(o.fecha_fin) : anio + '-11-30T23:59';
    const excluidas = o && o.categorias_excluidas ? o.categorias_excluidas.split(',') : [];

    const ahora = new Date().toLocaleString('sv-SE', { timeZone: 'America/Argentina/Buenos_Aires' }).slice(0, 16).replace(' ', 'T');
    let estado = ['Sin cargar', '#6c757d'];
    if (o) {
        if (!o.activo) estado = ['Apagada', '#dc3545'];
        else if (ahora < local(o.fecha_inicio)) estado = ['Programada: arranca sola en la fecha de inicio', '#b8860b'];
        else if (ahora > local(o.fecha_fin)) estado = ['Terminada', '#6c757d'];
        else estado = ['EN VIVO en la tienda', '#28a745'];
    }
%>
<div class="ofertas-container">
    <h2>🖤 Black Friday</h2>
    <p>Estado: <strong style="color: <%= estado[1] %>;"><%= estado[0] %></strong></p>
    <% if (campaniaMsg === 'guardada') { %><div class="alert alert-success">Campaña guardada.</div><% } %>
    <% if (campaniaMsg === 'apagada') { %><div class="alert alert-warning">Campaña apagada. La tienda volvió a los precios normales.</div><% } %>

    <form action="/admin/ofertas/campania" method="POST" class="form-oferta" id="form-campania">
        <h5>1. El descuento</h5>
        <div class="row">
            <div class="col-md-4 form-group">
                <label><strong>Nombre (se ve en cada producto)</strong></label>
                <input type="text" class="form-control" name="nombre" maxlength="60" required value="<%= o ? o.nombre : 'Black Friday' %>">
            </div>
            <div class="col-md-4 form-group">
                <label><strong>Tipo de descuento</strong></label>
                <select class="form-control" name="tipo_descuento">
                    <option value="porcentaje" <%= o && o.tipo_descuento === 'monto_fijo' ? '' : 'selected' %>>Porcentaje (%)</option>
                    <option value="monto_fijo" <%= o && o.tipo_descuento === 'monto_fijo' ? 'selected' : '' %>>Monto fijo (en la moneda del producto)</option>
                </select>
            </div>
            <div class="col-md-4 form-group">
                <label><strong>Cuánto</strong></label>
                <input type="number" step="0.01" min="0.01" class="form-control" name="valor_descuento" placeholder="Ej: 10" required value="<%= o ? Number(o.valor_descuento) : '' %>">
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 form-group">
                <label><strong>Empieza</strong></label>
                <input type="datetime-local" class="form-control" name="fecha_inicio" required value="<%= desde %>">
            </div>
            <div class="col-md-6 form-group">
                <label><strong>Termina</strong></label>
                <input type="datetime-local" class="form-control" name="fecha_fin" required value="<%= hasta %>">
            </div>
        </div>
        <% if (categorias.length) { %>
        <div class="form-group">
            <label><strong>Categorías que NO entran en la oferta</strong></label>
            <div style="display: flex; flex-wrap: wrap; gap: 10px;">
                <% categorias.forEach(cat => { %>
                <label class="cat-excluir-label" style="padding: 6px 14px; border: 2px solid #dee2e6; border-radius: 8px; cursor: pointer;">
                    <input type="checkbox" name="categorias_excluidas" value="<%= cat.id %>" <%= excluidas.includes(String(cat.id)) ? 'checked' : '' %>>
                    <%= cat.icono || '📦' %> <%= cat.nombre %>
                </label>
                <% }); %>
            </div>
        </div>
        <% } %>

        <h5 class="mt-4">2. Cómo salen los productos</h5>
        <div class="form-group">
            <label class="d-block"><input type="radio" name="vista" value="primero" <%= c.vista === 'primero' ? 'checked' : '' %>> <strong>Ofertas primero</strong>: el catálogo muestra primero los productos en oferta y después el resto.</label>
            <label class="d-block"><input type="radio" name="vista" value="solo" <%= c.vista === 'solo' ? 'checked' : '' %>> <strong>Solo ofertas</strong>: el catálogo abre con los productos en oferta, con un enlace "Ver todo el catálogo".</label>
            <label class="d-block"><input type="radio" name="vista" value="normal" <%= c.vista === 'normal' ? 'checked' : '' %>> <strong>Orden de siempre</strong>: solo cambian los precios.</label>
            <label class="d-block mt-2"><input type="checkbox" name="inicio" <%= c.inicio ? 'checked' : '' %>> Mostrar una sección Black Friday en la página de inicio (hasta 8 equipos)</label>
        </div>

        <h5 class="mt-4">3. El aviso al entrar</h5>
        <div class="form-group">
            <label><input type="checkbox" name="aviso" <%= c.aviso ? 'checked' : '' %>> <strong>Mostrar el aviso</strong> cuando alguien entra a la página</label>
        </div>
        <div class="row">
            <div class="col-md-6 form-group">
                <label><strong>Título</strong></label>
                <input type="text" class="form-control" name="titulo" maxlength="60" value="<%= c.titulo %>">
            </div>
            <div class="col-md-6 form-group">
                <label><strong>Texto del botón</strong></label>
                <input type="text" class="form-control" name="boton" maxlength="30" value="<%= c.boton %>">
            </div>
        </div>
        <div class="form-group">
            <label><strong>Mensaje</strong></label>
            <textarea class="form-control" name="mensaje" maxlength="220" rows="2"><%= c.mensaje %></textarea>
        </div>
        <button type="button" class="btn btn-dark mr-2" id="ver-aviso">👁 Vista previa del aviso</button>
        <button type="submit" class="btn-oferta btn-crear">✅ Guardar y programar</button>
    </form>

    <% if (o && o.activo) { %>
    <form action="/admin/ofertas/campania/apagar" method="POST" onsubmit="return confirm('¿Apagar la campaña y volver a los precios normales?')">
        <button type="submit" class="btn-oferta btn-eliminar">⏹ Apagar campaña</button>
    </form>
    <% } %>
</div>

<div id="previa" style="display:none; position:fixed; inset:0; z-index:3000; background:rgba(0,0,0,.65); align-items:center; justify-content:center; padding:20px; cursor:pointer;">
    <div style="width:100%; max-width:420px; background:#0d0d0f; color:#fff; border-radius:24px; padding:38px 28px 28px; text-align:center;">
        <h2 id="previa-titulo" style="color:#fff; font-weight:800; letter-spacing:.06em; overflow-wrap:anywhere;"></h2>
        <p id="previa-mensaje" style="color:#c9c9ce; overflow-wrap:anywhere;"></p>
        <span id="previa-boton" style="display:block; background:#fff; color:#0d0d0f; border-radius:999px; padding:13px; font-weight:700;"></span>
        <small style="display:block; margin-top:12px; color:#888;">Vista previa. Hacé clic para cerrar.</small>
    </div>
</div>
<script>
(function () {
    var f = document.getElementById('form-campania'), previa = document.getElementById('previa');
    document.getElementById('ver-aviso').addEventListener('click', function () {
        ['titulo', 'mensaje', 'boton'].forEach(function (k) { document.getElementById('previa-' + k).textContent = f.elements[k].value; });
        previa.style.display = 'flex';
    });
    previa.addEventListener('click', function () { previa.style.display = 'none'; });
})();
</script>
