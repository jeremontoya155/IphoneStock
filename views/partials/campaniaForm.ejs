<%
    const c = campaniaCfg;
    const o = campaniaOferta;
    // Las columnas son "hora local" sin zona: se muestran tal cual quedaron guardadas
    const p2 = n => String(n).padStart(2, '0');
    const local = d => { const x = new Date(d); return x.getFullYear() + '-' + p2(x.getMonth() + 1) + '-' + p2(x.getDate()) + 'T' + p2(x.getHours()) + ':' + p2(x.getMinutes()); };
    // Black Friday: viernes siguiente al cuarto jueves de noviembre
    const anio = new Date().getFullYear();
    const dia = 1 + ((4 - new Date(anio, 10, 1).getDay() + 7) % 7) + 22;
    const bfDesde = anio + '-11-' + p2(dia) + 'T00:00';
    const bfHasta = anio + '-11-30T23:59';
    const ahora = new Date().toLocaleString('sv-SE', { timeZone: 'America/Argentina/Buenos_Aires' }).slice(0, 16).replace(' ', 'T');
    const excluidas = o && o.categorias_excluidas ? o.categorias_excluidas.split(',') : [];
    const valor = o && o.tipo_descuento === 'porcentaje' ? Number(o.valor_descuento) : 0;
    const elegidos = (c.productos || []).map(Number);
    const enStock = products.filter(p => Number(p.stock) > 0 || elegidos.includes(Number(p.id)));

    let estado = ['Todavía no cargaste la oferta', 'gris'];
    if (o) {
        if (!o.activo) estado = ['Apagada', 'rojo'];
        else if (ahora < local(o.fecha_inicio)) estado = ['Programada: arranca sola en la fecha de inicio', 'ambar'];
        else if (ahora > local(o.fecha_fin)) estado = ['Terminada', 'gris'];
        else estado = ['EN VIVO en la tienda', 'verde'];
    }
%>
<link rel="stylesheet" href="/css/campania-admin.css?v=3">
<div class="ofertas-container bf" id="campania-box">
    <div class="bf-top">
        <h2>🖤 Black Friday</h2>
        <p class="bf-estado bf-estado--<%= estado[1] %>" id="bf-estado"><%= estado[0] %></p>
        <% if (o && o.activo) { %>
        <form action="/admin/ofertas/campania/apagar" method="POST" onsubmit="return confirm('¿Apagar la oferta y volver a los precios normales?')">
            <button type="submit" class="bf-apagar">⏹ Apagar la oferta</button>
        </form>
        <% } %>
    </div>
    <% if (campaniaMsg === 'guardada') { %><div class="alert alert-success">✅ Listo, quedó guardada. Mirá arriba el estado.</div><% } %>
    <% if (campaniaMsg === 'apagada') { %><div class="alert alert-warning">La oferta se apagó. La tienda volvió a los precios normales.</div><% } %>

    <ol class="bf-pasos" id="bf-pasos">
        <li>1. Equipos</li><li>2. Descuento</li><li>3. Fechas</li><li>4. Aviso</li><li>5. Confirmar</li>
    </ol>

    <form action="/admin/ofertas/campania" method="POST" id="form-campania" novalidate data-editar="<%= o ? (o.activo ? 'si' : 'apagada') : '' %>" data-reglas="<%= JSON.stringify({ agrupar: c.agrupar, porGrupo: c.porGrupo }) %>">
        <input type="hidden" name="por_grupo" id="bf-porgrupo">
        <input type="hidden" name="nombre" value="<%= o ? o.nombre : 'Black Friday' %>">
        <input type="hidden" name="tipo_descuento" value="porcentaje">
        <input type="hidden" name="productos" id="bf-productos">

        <!-- 1 -->
        <section class="bf-paso">
            <h3>¿Qué equipos van en oferta?</h3>
            <div class="bf-opciones">
                <label class="bf-opcion"><input type="radio" name="alcance" value="todos" <%= elegidos.length ? '' : 'checked' %>><span><b>Todos</b>Toda la tienda en oferta</span></label>
                <label class="bf-opcion"><input type="radio" name="alcance" value="elegidos" <%= elegidos.length ? 'checked' : '' %>><span><b>Los elijo yo</b>Tocás las fotos que quieras</span></label>
            </div>

            <div id="bf-todos">
                <% if (categorias.length) { %>
                <p class="bf-ayuda">¿Querés dejar algo afuera? Tocá lo que <b>NO</b> lleva descuento:</p>
                <div class="bf-chips">
                    <% categorias.forEach(cat => { %>
                    <label class="bf-chip bf-chip--no"><input type="checkbox" name="categorias_excluidas" value="<%= cat.id %>" <%= excluidas.includes(String(cat.id)) ? 'checked' : '' %>><span><%= cat.icono || '📦' %> <%= cat.nombre %></span></label>
                    <% }); %>
                </div>
                <% } %>
            </div>

            <div id="bf-elegir">
                <input type="search" id="bf-buscar" class="bf-buscar" placeholder="🔍 Buscar: 15 pro, airpods, 256..." autocomplete="off">
                <p class="bf-ayuda"><b id="bf-cuantos">0</b> equipos elegidos. <button type="button" class="bf-link" id="bf-marcar">Elegir los que se ven</button> · <button type="button" class="bf-link" id="bf-limpiar">Quitar todos</button></p>
                <div class="bf-grilla">
                    <% enStock.forEach(p => { const usd = (p.moneda || 'USD') === 'USD'; %>
                    <label class="bf-prod" data-id="<%= p.id %>" data-cat="<%= p.categoria_id || '' %>" data-catnombre="<%= (categorias.find(x => x.id === p.categoria_id) || {}).nombre || 'Sin categoría' %>" data-precio="<%= p.price %>" data-moneda="<%= usd ? 'USD' : 'ARS $' %>" data-nombre="<%= p.name %>">
                        <input type="checkbox" class="bf-check" value="<%= p.id %>" <%= elegidos.includes(Number(p.id)) ? 'checked' : '' %>>
                        <img src="<%= String(p.img || '').replace('/upload/', '/upload/w_200,f_auto,q_auto/') %>" alt="" loading="lazy">
                        <span class="bf-prod__n"><%= p.name %></span>
                        <span class="bf-prod__p"><%= usd ? 'USD' : 'ARS $' %> <%= Number(p.price).toLocaleString('es-AR') %></span>
                    </label>
                    <% }); %>
                </div>
            </div>
        </section>

        <!-- 2 -->
        <section class="bf-paso">
            <h3>¿Cuánto descuento?</h3>
            <div class="bf-numeros">
                <% [5, 10, 15, 20, 25, 30].forEach(n => { %><button type="button" class="bf-num" data-valor="<%= n %>"><%= n %>%</button><% }); %>
            </div>
            <label class="bf-otro">Otro número: <input type="number" name="valor_descuento" id="bf-valor" min="1" max="90" step="1" value="<%= valor || '' %>" inputmode="numeric"> %</label>
            <h5>¿El mismo descuento para todo?</h5>
            <div class="bf-opciones">
                <label class="bf-opcion"><input type="radio" name="agrupar" value="no" <%= c.agrupar !== 'categoria' && c.agrupar !== 'modelo' ? 'checked' : '' %>><span><b>Sí, igual</b>Todo con el mismo número</span></label>
                <label class="bf-opcion"><input type="radio" name="agrupar" value="categoria" <%= c.agrupar === 'categoria' ? 'checked' : '' %>><span><b>Por categoría</b>Equipos uno, Accesorios otro...</span></label>
                <label class="bf-opcion"><input type="radio" name="agrupar" value="modelo" <%= c.agrupar === 'modelo' ? 'checked' : '' %>><span><b>Por modelo</b>iPhone 15 uno, iPhone 16 otro...</span></label>
            </div>
            <div id="bf-grupos"></div>

            <p class="bf-ayuda">Así van a quedar los precios:</p>
            <ul class="bf-ejemplos" id="bf-ejemplos"></ul>
        </section>

        <!-- 3 -->
        <section class="bf-paso">
            <h3>¿Cuándo?</h3>
            <div class="bf-opciones">
                <button type="button" class="bf-fecha" data-modo="bf" data-desde="<%= bfDesde %>" data-hasta="<%= bfHasta %>"><b>Black Friday</b>Del viernes <%= dia %> al lunes 30</button>
                <button type="button" class="bf-fecha" data-modo="ya"><b>Desde ahora</b>Arranca ya y dura 3 días</button>
            </div>
            <div class="bf-fechas">
                <label>Empieza <input type="datetime-local" name="fecha_inicio" value="<%= o ? local(o.fecha_inicio) : bfDesde %>"></label>
                <label>Termina <input type="datetime-local" name="fecha_fin" value="<%= o ? local(o.fecha_fin) : bfHasta %>"></label>
            </div>
            <p class="bf-ayuda">Arranca y termina sola. No tenés que acordarte.</p>
        </section>

        <!-- 4 -->
        <section class="bf-paso">
            <h3>El aviso para los clientes</h3>
            <label class="bf-si"><input type="checkbox" name="aviso" <%= c.aviso ? 'checked' : '' %>> Mostrar un aviso cuando alguien entra a la página</label>
            <div class="bf-dos">
                <div class="bf-campos">
                    <label>Título <input type="text" name="titulo" maxlength="60" value="<%= c.titulo %>"></label>
                    <label>Mensaje <textarea name="mensaje" maxlength="220" rows="3"><%= c.mensaje %></textarea></label>
                    <label>Botón <input type="text" name="boton" maxlength="30" value="<%= c.boton %>"></label>
                </div>
                <div class="bf-previa" aria-label="Así lo ve el cliente">
                    <h4 id="previa-titulo"></h4>
                    <p id="previa-mensaje"></p>
                    <span id="previa-boton"></span>
                </div>
            </div>
            <h5>¿Cómo se ven los equipos en el catálogo?</h5>
            <div class="bf-opciones">
                <label class="bf-opcion"><input type="radio" name="vista" value="primero" <%= c.vista === 'primero' ? 'checked' : '' %>><span><b>Ofertas primero</b>Después, el resto</span></label>
                <label class="bf-opcion"><input type="radio" name="vista" value="solo" <%= c.vista === 'solo' ? 'checked' : '' %>><span><b>Solo ofertas</b>Con botón "Ver todo"</span></label>
                <label class="bf-opcion"><input type="radio" name="vista" value="normal" <%= c.vista === 'normal' ? 'checked' : '' %>><span><b>Como siempre</b>Solo cambia el precio</span></label>
            </div>
            <label class="bf-si"><input type="checkbox" name="inicio" <%= c.inicio ? 'checked' : '' %>> Mostrar también las ofertas en la página de inicio</label>
        </section>

        <!-- 5 -->
        <section class="bf-paso">
            <h3 id="bf-resumen-titulo">Revisá antes de publicar</h3>
            <p class="bf-ayuda" id="bf-resumen-ayuda" hidden>Tocá <b>Cambiar</b> solo en lo que quieras tocar y después guardá. No hace falta repetir los pasos.</p>
            <ul class="bf-resumen" id="bf-resumen"></ul>
        </section>

        <p class="bf-error" id="bf-error" role="alert"></p>
        <p class="bf-pendiente" id="bf-sinGuardar" hidden>Tenés cambios sin guardar. La tienda no cambia hasta que guardes.</p>
        <div class="bf-nav">
            <button type="button" class="bf-btn bf-btn--atras" id="bf-atras">← Atrás</button>
            <button type="button" class="bf-btn" id="bf-sigue">Siguiente →</button>
            <button type="submit" class="bf-btn bf-btn--ok" id="bf-publicar">✅ Publicar la oferta</button>
        </div>
    </form>
</div>
<script src="/js/campania-admin.js?v=3"></script>
