<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Carrusel</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/index.css"> <!-- Asegúrate de que la ruta a index.css sea correcta -->
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

    <%- include('partials/navbarUser') %> <!-- Asegúrate de que la ruta 'partials/navbarUser' sea correcta -->

    <div class="container my-4">
        <h1 class="text-center">Editar Carrusel</h1>
        <p class="text-center text-muted">Las imágenes se suben automáticamente a Cloudinary. La primera de la lista es la primera que se muestra al entrar.</p>
        
        <!-- Formulario para agregar nuevo elemento al carrusel -->
        <form action="/add-carousel" method="POST" enctype="multipart/form-data" class="mb-5 p-3 border rounded">
            <h3>Agregar imagen</h3>
            <div class="form-group">
                <label for="newText">Texto alternativo</label>
                <input type="text" class="form-control" id="newText" name="text" placeholder="Ej: Promo iPhone">
            </div>
            <div class="form-group">
                <label for="newImage">Imagen principal</label>
                <input type="file" class="form-control" id="newImage" name="image" accept="image/*" required>
            </div>
            <div class="form-group">
                <label for="newMobileImage">Imagen mobile opcional</label>
                <input type="file" class="form-control" id="newMobileImage" name="mobileImage" accept="image/*">
                <small class="form-text text-muted">Si no cargás una mobile, se usa la principal.</small>
            </div>
            <input type="hidden" name="color1" value="#ffffff">
            <input type="hidden" name="color2" value="#ffffff">
            <button type="submit" class="btn btn-success">Agregar al carrusel</button>
        </form>

        <% if (carouselItems && carouselItems.length > 0) { %>
            <% carouselItems.forEach((item, index) => { %>
                <form action="/edit-carousel" method="POST" enctype="multipart/form-data" class="mb-4 p-3 border rounded">
                    <h4>Imagen <%= index + 1 %><%= index === 0 ? ' (primera al entrar)' : '' %></h4>
                    <input type="hidden" name="id" value="<%= item.id %>">
                    <div class="form-group">
                        <label for="text<%= item.id %>">Texto alternativo</label>
                        <input type="text" class="form-control" id="text<%= item.id %>" name="text" value="<%= item.text %>">
                    </div>
                    <div class="form-group">
                        <label for="image<%= item.id %>">Cambiar imagen principal</label>
                        <input type="file" class="form-control" id="image<%= item.id %>" name="image" accept="image/*">
                        <img src="<%= item.img %>" alt="Imagen actual" class="img-fluid mt-2">
                    </div>
                    <div class="form-group">
                        <label for="imagenMobile<%= item.id %>">Cambiar imagen mobile</label>
                        <input type="file" class="form-control" id="imagenMobile<%= item.id %>" name="mobileImage" accept="image/*">
                        <img src="<%= item.imagenmobile || item.img %>" alt="Imagen móvil actual" class="img-fluid mt-2">
                    </div>
                    <input type="hidden" name="color1" value="<%= item.color1 || '#ffffff' %>">
                    <input type="hidden" name="color2" value="<%= item.color2 || '#ffffff' %>">
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </form>
                <form action="/delete-carousel" method="POST" class="mb-5">
                    <input type="hidden" name="id" value="<%= item.id %>">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
                <hr>
            <% }); %>
        <% } else { %>
            <p>No hay elementos en el carrusel.</p>
        <% } %>
        
        <a href="/" class="btn btn-secondary">Volver</a>
    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.3/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
