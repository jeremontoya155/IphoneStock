                <div class="products-container" id="cart-items">
                    <% 
                        // Mostrar los 6 productos MÁS CAROS cuyo nombre contenga '16' o '17'
                        function normalizeText(s) {
                          return String(s || '').toLowerCase().normalize('NFD').replace(/[^\w\s]/g, '').replace(/\s+/g, ' ').trim();
                        }

                        const filteredByModel = (products || [])
                          .filter(p => p.price > 0 && p.name && (normalizeText(p.name).includes('16') || normalizeText(p.name).includes('17')))
                          .sort((a, b) => b.price - a.price) // mayor precio primero
                          .slice(0, 6);

                        filteredByModel.forEach(product => {
                    %>
                        <% if (product.stock > 0) { %>
                            <%- include('partials/productCard', { product: product }) %>
                        <% } %>
                    <% }); %>
                </div>
